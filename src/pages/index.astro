---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar";
import Hero from "../components/Hero";
import Slider from "../components/Slider";
import AnatomyShowcase from "../components/AnatomyShowcase";
import Services from "../components/Services";
import Work from "../components/Work";
import Stockist from "../components/Stockist";
import Faq from "../components/Faq";
import Contact from "../components/Contact";
import Footer from "../components/Footer";
import ChristmasTouches from "../components/christmas/ChristmasTouches.astro";
import { CHRISTMAS } from "../config/seasonal";
---

<BaseLayout>
  <!-- `fr-ink` sets the dark surface tokens for the whole page; individual
       sections flip to paper/amber with their own surface class. -->
  <div class="fr-ink relative isolate overflow-x-clip">
    <!-- Scroll position shown as a print job: a hairline bar up top and a
         small readout in the left gutter (desktop only). -->
    <div id="fr-progress" class="fr-progress" aria-hidden="true"></div>
    <div
      id="fr-progress-readout"
      class="fr-progress-readout"
      aria-hidden="true"
    >
      Printing 000%
    </div>

    <div class="fr-grain" aria-hidden="true"></div>

    {CHRISTMAS && <ChristmasTouches />}
    <Navbar client:load />
    <Hero client:idle festive={CHRISTMAS} />

    <div id="theme-scope" class="relative">
      <Slider client:visible />
      <Stockist client:idle />
      <AnatomyShowcase client:visible />
      <Services client:visible />
      <Work client:visible />
      <Faq client:visible />
      <Contact client:visible />
    </div>

    <Footer client:idle />
  </div>
</BaseLayout>

<script is:inline>
  document.documentElement.setAttribute("data-theme", "dark");
  document.documentElement.classList.add("dark");

  // Print progress: one rAF-throttled scroll listener, transform-only updates.
  (() => {
    const bar = document.getElementById("fr-progress");
    const readout = document.getElementById("fr-progress-readout");
    if (!bar) return;
    let queued = false;
    const update = () => {
      queued = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      bar.style.transform = "scaleX(" + p + ")";
      if (readout) {
        readout.textContent =
          p >= 0.995
            ? "Print complete"
            : "Printing " + String(Math.round(p * 100)).padStart(3, "0") + "%";
      }
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue);
    update();
  })();
</script>
