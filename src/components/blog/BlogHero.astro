---
// Static hero: the headline and intro animate in with CSS, so they show on
// first paint instead of waiting for JavaScript. Only the Aurora orb is a
// React island, and it loads on large screens, the only place it shows.
import Aurora from "../reactbits/Aurora";

const lore = "Lore &".split("");
const intro =
  "Product drops, booth tales, and behind-the-scenes myths from our Leeds workshop.".split(
    " ",
  );
const ticks = ["Booth tales", "Drop announcements", "Workshop myths"];
---

<section class="relative overflow-hidden bg-[#0a0f1a]">
  {/* Subtle ambient glows */}
  <div class="pointer-events-none absolute inset-0">
    <div
      class="absolute -left-40 -top-40 h-[900px] w-[900px] rounded-full"
      style="background: radial-gradient(closest-side, rgba(37,99,235,0.12), transparent); animation: glow-pulse 4s ease-in-out infinite;"
    >
    </div>
    <div
      class="absolute -right-40 top-10 h-[760px] w-[760px] rounded-full"
      style="background: radial-gradient(closest-side, rgba(79,70,229,0.1), transparent); animation: glow-pulse 4s ease-in-out infinite 1s;"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.02]"
      style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 80px 80px;"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-8 py-16 sm:py-24 lg:grid-cols-2 lg:py-32">
      {/* Left: text */}
      <div>
        <div class="mb-4 sm:mb-5 inline-flex items-center gap-3">
          <div class="w-8 h-px bg-blue-400/50"></div>
          <span
            class="text-[13px] sm:text-[15px] font-medium uppercase tracking-[0.28em] text-blue-300/70"
            style="font-family: 'Jost', sans-serif;"
          >
            ForgeRealm Journal
          </span>
        </div>

        <h1
          class="text-3xl font-bold leading-[0.95] tracking-tight sm:text-5xl lg:text-[4rem]"
          style="font-family: 'Cinzel', serif;"
        >
          <span class="inline" aria-label="Lore &">
            {
              lore.map((ch, i) => (
                <span
                  aria-hidden="true"
                  class="hero-rise"
                  style={`animation-delay: ${i * 30}ms;`}
                >
                  {ch === " " ? " " : ch}
                </span>
              ))
            }
          </span>
          <br />
          <span
            class="inline-flex items-center text-3xl sm:text-5xl lg:text-[4rem]"
          >
            <span
              class="hero-gradient inline-block relative z-[2] text-transparent bg-clip-text"
            >
              <span
                style="font-family: 'Cormorant Garamond', serif; font-style: italic; font-weight: 300; font-size: 1.1em;"
              >
                Legends
              </span>
            </span>
          </span>
        </h1>

        <div class="mt-5 sm:mt-6 max-w-md">
          <span
            class="text-base sm:text-lg leading-relaxed text-slate-400/90"
            aria-label={intro.join(" ")}
          >
            {
              intro.map((word, i) => (
                <span
                  aria-hidden="true"
                  class="hero-blur"
                  style={`animation-delay: ${i * 30}ms;`}
                >
                  {i < intro.length - 1 ? `${word} ` : word}
                </span>
              ))
            }
          </span>
        </div>

        <div class="mt-8 flex flex-wrap gap-2.5 sm:gap-3">
          <a
            href="/subscribe"
            class="group relative inline-flex items-center gap-2 overflow-hidden rounded-full bg-gradient-to-r from-blue-500 via-blue-400 to-cyan-400 px-6 py-2.5 sm:px-7 sm:py-3 text-[12px] sm:text-[15px] font-semibold uppercase tracking-[0.14em] text-white shadow-xl shadow-blue-500/25 transition-all hover:-translate-y-0.5 hover:shadow-blue-500/40"
            style="font-family: 'Cinzel', serif;"
          >
            <span class="relative z-10">Subscribe</span>
            <div
              class="absolute inset-0 bg-gradient-to-r from-cyan-400 via-blue-400 to-blue-500 opacity-0 transition-opacity group-hover:opacity-100"
            >
            </div>
          </a>
          <a
            href="/"
            class="inline-flex items-center gap-2 rounded-full border border-white/[0.12] bg-white/[0.03] px-6 py-2.5 sm:px-7 sm:py-3 text-[12px] sm:text-[15px] font-semibold uppercase tracking-[0.14em] text-white/70 transition-all hover:border-blue-400/30 hover:text-white"
            style="font-family: 'Cinzel', serif;"
          >
            Main Site
          </a>
        </div>

        <div
          class="mt-6 sm:mt-8 flex flex-wrap gap-x-4 sm:gap-x-5 gap-y-1.5 text-[13px] sm:text-[15px] text-slate-500"
        >
          {
            ticks.map((t) => (
              <span class="inline-flex items-center gap-1.5">
                <svg
                  class="h-3 w-3 sm:h-3.5 sm:w-3.5 text-emerald-500/60"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"
                  />
                </svg>
                {t}
              </span>
            ))
          }
        </div>
      </div>

      {/* Right: Aurora portal */}
      <div class="relative hidden lg:flex items-center justify-center">
        <div class="relative mx-auto w-[380px] h-[380px]">
          {/* Outer glow rings */}
          <div
            class="absolute -inset-8 rounded-full border border-white/[0.04]"
          >
          </div>
          <div
            class="absolute -inset-16 rounded-full border border-white/[0.02]"
          >
          </div>
          <div
            class="absolute -inset-4 rounded-full bg-gradient-to-br from-blue-500/10 via-transparent to-cyan-500/10 blur-2xl"
            style="animation: glow-pulse 4s ease-in-out infinite;"
          >
          </div>

          {/* Aurora orb */}
          <div
            class="relative w-full h-full rounded-full overflow-hidden border border-white/[0.08] shadow-2xl shadow-blue-500/20"
          >
            <Aurora
              client:media="(min-width: 1024px)"
              colorStops={["#3b82f6", "#06b6d4", "#10b981"]}
              amplitude={1.4}
              blend={0.7}
              speed={0.6}
            />
            {/* Inner overlay for depth */}
            <div
              class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_30%,#0a0f1a_80%)]"
            >
            </div>
            <div
              class="absolute inset-0 bg-gradient-to-t from-[#0a0f1a]/60 via-transparent to-transparent"
            >
            </div>

            {/* Center content */}
            <div
              class="absolute inset-0 flex flex-col items-center justify-center text-center"
            >
              <div class="relative">
                <div
                  class="absolute -inset-6 rounded-full bg-gradient-to-r from-blue-500/20 to-cyan-400/20 blur-2xl"
                  style="animation: glow-pulse 4s ease-in-out infinite;"
                >
                </div>
                <img
                  src="/frlogorv-384.webp"
                  alt="ForgeRealm"
                  width="100"
                  height="100"
                  class="relative rounded-2xl"
                  style="animation: float 6s ease-in-out infinite;"
                  loading="lazy"
                />
              </div>
              <p
                class="mt-4 text-xs tracking-[0.3em] uppercase text-slate-400"
                style="font-family: 'Jost', sans-serif;"
              >
                The Journal
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Bottom fade */}
  <div
    class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-[#0a0f1a] to-transparent"
  >
  </div>
</section>

<style>
  .hero-rise,
  .hero-blur {
    display: inline-block;
    animation-fill-mode: both;
  }
  .hero-rise {
    animation: hero-rise 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-blur {
    animation: hero-blur 500ms ease both;
  }
  .hero-gradient {
    background-image: linear-gradient(
      to right,
      #3b82f6,
      #06b6d4,
      #10b981,
      #3b82f6,
      #3b82f6
    );
    background-size: 300% 100%;
    -webkit-background-clip: text;
    animation: hero-gradient 6s linear infinite alternate;
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }
  @keyframes hero-blur {
    from {
      opacity: 0;
      filter: blur(12px);
      transform: translateY(8px);
    }
  }
  @keyframes hero-gradient {
    from {
      background-position: 0% 50%;
    }
    to {
      background-position: 100% 50%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-rise,
    .hero-blur,
    .hero-gradient {
      animation: none;
    }
  }
</style>
