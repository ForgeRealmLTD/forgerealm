---
// Rendered as static HTML: the entries show as soon as the page arrives,
// and the small script at the bottom adds the scroll effects on top.
import { stalls } from "~/data/stalls";

// Resized WebP copies made by scripts/blog-image-variants.js
// (/blog/foo.jpg -> /blog/sized/foo-640.webp and foo-1280.webp).
const sized = (src: string, width: number) =>
  src.replace(/^\/blog\/(.+)\.\w+$/, `/blog/sized/$1-${width}.webp`);

// Rendered tile width per grid layout, so phones and 3-up rows pick 640.
const imageSizes = (count: number) =>
  count === 1
    ? "(min-width: 1024px) 900px, 100vw"
    : count === 2
      ? "(min-width: 1024px) 450px, (min-width: 640px) 50vw, 100vw"
      : "(min-width: 1024px) 300px, (min-width: 640px) 50vw, 100vw";

const latestStallIndex = stalls.findIndex((s) => s.kind !== "note");

const theme = (isNote: boolean) =>
  isNote
    ? {
        dotGradient: "from-amber-300 to-orange-400",
        dotBorder: "border-amber-300/30",
        dotShadow: "shadow-[0_0_0_3px_rgba(251,191,36,0.08)]",
        dotShadowMd: "shadow-[0_0_0_4px_rgba(251,191,36,0.08)]",
        labelColor: "text-amber-300/70",
        dividerColor: "from-amber-400/30 via-orange-500/10",
        cardGradient:
          "from-amber-500/[0.05] via-transparent to-orange-500/[0.03]",
        pullBorder: "border-amber-400/40",
        pullText: "text-amber-100/90",
      }
    : {
        dotGradient: "from-cyan-300 to-blue-500",
        dotBorder: "border-cyan-300/30",
        dotShadow: "shadow-[0_0_0_3px_rgba(6,182,212,0.08)]",
        dotShadowMd: "shadow-[0_0_0_4px_rgba(6,182,212,0.08)]",
        labelColor: "text-cyan-300/70",
        dividerColor: "from-cyan-400/30 via-blue-500/10",
        cardGradient: "from-cyan-500/[0.04] via-transparent to-blue-500/[0.04]",
        pullBorder: "border-cyan-400/40",
        pullText: "text-cyan-100/90",
      };
---

<div
  data-timeline
  class="not-prose relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 my-10"
>
  <div
    class="absolute top-0 left-9 sm:left-11 md:left-[66px] lg:left-[72px] w-px h-full bg-gradient-to-b from-transparent via-white/[0.08] to-transparent"
    aria-hidden="true"
  >
    <div
      data-timeline-fill
      class="absolute inset-x-0 top-0 w-px bg-gradient-to-b from-cyan-300 via-cyan-400 to-blue-500"
      style="height: 0; opacity: 0;"
    >
      {/* Pulsing tip (leading edge of the fill) */}
      <div class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 h-3 w-3">
        <span
          class="absolute inset-0 animate-ping rounded-full bg-cyan-300 opacity-60"
        ></span>
        <span
          class="absolute inset-0 rounded-full bg-cyan-300 shadow-[0_0_10px_2px_rgba(103,232,249,0.7)]"
        ></span>
      </div>
    </div>
  </div>

  <div class="relative">
    {
      stalls.map((stall, index) => {
        const isNote = stall.kind === "note";
        const isLatest = index === latestStallIndex;
        const t = theme(isNote);
        const images = stall.images ?? [];
        return (
          <div
            data-stall-entry
            id={isLatest ? "latest-stall" : undefined}
            class="relative flex flex-col md:flex-row md:gap-10 pb-16 sm:pb-24 pl-12 md:pl-0 scroll-mt-24"
          >
            <div
              data-stall-dot
              class={`md:hidden absolute left-3 top-2 h-4 w-4 rounded-full border ${t.dotBorder} bg-[#0a0f1a] ${t.dotShadow}`}
            >
              <div
                class={`absolute inset-1 rounded-full bg-gradient-to-br ${t.dotGradient}`}
              />
            </div>
            <div class="sticky top-24 md:top-32 self-start md:w-64 md:flex-shrink-0 md:pl-24 z-10 -mt-2 mb-6 md:mb-0">
              <div
                data-stall-dot
                class={`hidden md:block absolute left-8 top-2 h-5 w-5 rounded-full border ${t.dotBorder} bg-[#0a0f1a] ${t.dotShadowMd}`}
              >
                <div
                  class={`absolute inset-1 rounded-full bg-gradient-to-br ${t.dotGradient}`}
                />
              </div>
              <div class="flex items-center gap-3 md:flex-col md:items-start">
                <span
                  class={`text-[10px] sm:text-[11px] font-medium uppercase tracking-[0.28em] ${t.labelColor}`}
                  style="font-family: Jost, sans-serif;"
                >
                  {stall.label}
                </span>
                <div class="hidden md:block w-8 h-px bg-cyan-400/30" />
                <span
                  class="text-sm sm:text-base text-white"
                  style="font-family: Cinzel, serif;"
                >
                  {stall.date}
                </span>
              </div>
            </div>

            <div data-stall-card class="flex-1 md:pr-4">
              <div class="rounded-2xl border border-white/[0.08] bg-white/[0.03] p-5 sm:p-7 relative overflow-hidden">
                <div
                  class={`absolute inset-0 bg-gradient-to-br ${t.cardGradient} pointer-events-none`}
                />
                <div class="relative">
                  {!isNote && stall.location && (
                    <div class="flex flex-wrap items-center gap-2 mb-3">
                      <span
                        class="rounded-full border border-cyan-300/20 bg-cyan-300/10 px-2.5 py-0.5 text-[10px] font-medium uppercase tracking-[0.2em] text-cyan-200"
                        style="font-family: Jost, sans-serif;"
                      >
                        {stall.location}
                      </span>
                    </div>
                  )}

                  <h3
                    class="text-xl sm:text-2xl lg:text-[26px] leading-[1.2] text-white"
                    style="font-family: Cinzel, serif;"
                  >
                    {stall.title}
                  </h3>

                  <div
                    class={`mt-5 h-px w-full bg-gradient-to-r ${t.dividerColor} to-transparent`}
                  />

                  <div
                    class="mt-6 space-y-4"
                    style="font-family: Inter, sans-serif;"
                  >
                    {stall.paragraphs.map((p) => (
                      <p class="text-[15px] sm:text-base text-slate-300 leading-[1.8]">
                        {p}
                      </p>
                    ))}
                  </div>

                  {stall.pull && (
                    <blockquote
                      class={`mt-6 border-l-2 ${t.pullBorder} pl-5 py-1`}
                    >
                      <p
                        class={`text-base sm:text-lg ${t.pullText}`}
                        style="font-family: 'Cormorant Garamond', serif; font-style: italic; line-height: 1.6;"
                      >
                        "{stall.pull}"
                      </p>
                    </blockquote>
                  )}

                  {images.length > 0 && (
                    <div
                      class={`mt-7 grid gap-3 ${images.length === 1 ? "grid-cols-1" : images.length === 2 ? "grid-cols-1 sm:grid-cols-2" : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"}`}
                    >
                      {images.map((img, i) => (
                        <figure class="group relative overflow-hidden rounded-xl border border-white/[0.06] bg-[#0c1220]">
                          <img
                            src={sized(img.src, 640)}
                            srcset={`${sized(img.src, 640)} 640w, ${sized(img.src, 1280)} 1280w`}
                            sizes={imageSizes(images.length)}
                            alt={img.alt}
                            loading={index === 0 && i === 0 ? "eager" : "lazy"}
                            decoding="async"
                            class={`h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03] ${img.portrait ? "aspect-[3/4]" : "aspect-[4/3]"}`}
                          />
                          <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
                        </figure>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</div>

<style>
  [data-stall-card] {
    transition:
      opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Only cards that start below the fold are hidden, so nothing on screen
     at load waits for the script. */
  [data-stall-card].reveal-pending {
    opacity: 0;
    transform: translateY(24px);
  }
  [data-stall-dot].dot-pulse {
    animation: stall-dot-pulse 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes stall-dot-pulse {
    50% {
      transform: scale(1.6);
    }
  }
</style>

<script>
  const timeline = document.querySelector<HTMLElement>("[data-timeline]");
  const fill = document.querySelector<HTMLElement>("[data-timeline-fill]");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  // Progress line: fills as the timeline passes the middle of the screen.
  if (timeline && fill) {
    let queued = false;
    const update = () => {
      queued = false;
      const rect = timeline.getBoundingClientRect();
      const mid = window.innerHeight / 2;
      const progress = Math.min(1, Math.max(0, (mid - rect.top) / rect.height));
      fill.style.height = `${progress * rect.height}px`;
      fill.style.opacity = String(Math.min(1, progress / 0.05));
    };
    const onScroll = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  }

  if (!reduceMotion) {
    // Cards below the fold fade up as they scroll into view.
    const reveal = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.remove("reveal-pending");
            reveal.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -80px 0px" },
    );
    for (const card of document.querySelectorAll("[data-stall-card]")) {
      if (card.getBoundingClientRect().top > window.innerHeight) {
        card.classList.add("reveal-pending");
        reveal.observe(card);
      }
    }

    // Each entry's dot pulses as it enters the reading zone.
    const pulse = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const dot of entry.target.querySelectorAll("[data-stall-dot]")) {
            dot.classList.remove("dot-pulse");
            void (dot as HTMLElement).offsetWidth;
            dot.classList.add("dot-pulse");
          }
        }
      },
      { rootMargin: "-40% 0px -50% 0px" },
    );
    for (const entry of document.querySelectorAll("[data-stall-entry]")) {
      pulse.observe(entry);
    }
  }
</script>
